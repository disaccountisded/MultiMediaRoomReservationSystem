@model IEnumerable<Reservation>
@{
    ViewData["Title"] = "Reservations";
    var total = Model.Count();
    var pending = Model.Count(r => r.Status == ReservationStatus.Pending);
    var approved = Model.Count(r => r.Status == ReservationStatus.Approved);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <p class="text-primary fw-semibold text-uppercase small mb-1">School facility</p>
        <h1 class="h2 fw-bold mb-1">Multi Media Room Reservations</h1>
        <p class="text-secondary mb-0">View and manage reservation requests for this venue.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ New Reservation</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card summary-card h-100"><div class="card-body">
            <div class="text-secondary small">Total requests</div>
            <div class="display-6 fw-semibold">@total</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card summary-card h-100"><div class="card-body">
            <div class="text-secondary small">Pending</div>
            <div class="display-6 fw-semibold text-warning">@pending</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card summary-card h-100"><div class="card-body">
            <div class="text-secondary small">Approved</div>
            <div class="display-6 fw-semibold text-success">@approved</div>
        </div></div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h2 class="h5 mb-0">Reservation records</h2>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <h3 class="h5">No reservations yet</h3>
                <p class="text-secondary">Create the first Multi Media Room reservation request.</p>
                <a asp-action="Create" class="btn btn-primary">Create Reservation</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Requester</th><th>Date</th><th>Time</th><th>Purpose</th>
                            <th>Attendees</th><th>Status</th><th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@item.ReservedBy</div>
                                <div class="small text-secondary">@item.Department</div>
                            </td>
                            <td class="text-nowrap">@item.ReservationDate.ToString("MMM dd, yyyy")</td>
                            <td class="text-nowrap">@DateTime.Today.Add(item.StartTime).ToString("h:mm tt") – @DateTime.Today.Add(item.EndTime).ToString("h:mm tt")</td>
                            <td class="purpose-cell">@item.Purpose</td>
                            <td>@item.NumberOfAttendees</td>
                            <td>
                                @if (item.Status == ReservationStatus.Pending)
                                { <span class="badge text-bg-warning">Pending</span> }
                                else if (item.Status == ReservationStatus.Approved)
                                { <span class="badge text-bg-success">Approved</span> }
                                else
                                { <span class="badge text-bg-danger">Rejected</span> }
                            </td>
                            <td>
                                <div class="d-flex flex-wrap justify-content-end gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">View</a>
                                    @if (item.Status == ReservationStatus.Pending)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                        <form asp-action="Approve" asp-route-id="@item.Id" method="post">
                                            <button class="btn btn-sm btn-success" type="submit">Approve</button>
                                        </form>
                                        <form asp-action="Reject" asp-route-id="@item.Id" method="post">
                                            <button class="btn btn-sm btn-outline-danger" type="submit">Reject</button>
                                        </form>
                                    }
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
